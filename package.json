{
  "name": "ai-interview-prep-kit",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "client",
    "server",
    "shared",
    "evaluation"
  ],
  "scripts": {
    "dev": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "dev:all": "concurrently -k -n api,web -c cyan,magenta \"npm run dev:server\" \"npm run dev\"",
    "test": "npm test --workspaces",
    "evaluate": "npm run evaluate --workspace evaluation --",
    "build": "npm run build --workspaces"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
