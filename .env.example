# LLM provider
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
BRAVE_SEARCH_API_KEY=

# Durable kit persistence
KIT_STORE_FILE=.data/kits.json

# App
NEXT_PUBLIC_API_URL=http://localhost:4000
PORT=4000
SESSION_SECRET=change-me

# Maximum time for a single Gemini generation request (milliseconds)
GEMINI_TIMEOUT_MS=60000
