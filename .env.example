# LLM provider
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
BRAVE_SEARCH_API_KEY=

# Durable kit persistence
KIT_STORE_FILE=.data/kits.json

# App
NEXT_PUBLIC_API_URL=http://localhost:4000
PORT=4000
SESSION_SECRET=change-me

# Maximum time for a single Gemini generation request (milliseconds)
GEMINI_TIMEOUT_MS=60000

# LLM provider: gemini | openai | anthropic | groq | ollama
LLM_PROVIDER=gemini
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
